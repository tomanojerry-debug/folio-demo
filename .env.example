# Server only. Never put keys in site/.
ZHIPU_CODING_API_KEY=
ZHIPU_TEXT_MODEL=glm-5.3-flash
# Standard API endpoint for application use. Keep credentials on the server.
ZHIPU_CODING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_REASONING_EFFORT=low
# Optional image understanding with a MiniMax application API key.
MINIMAX_API_KEY=
FORME_SESSION_SECRET=
# Optional alternative quota/cache backend. If absent, use the Worker ledger.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FORME_DAILY_LIMIT=100
FORME_VISITOR_DAILY_LIMIT=30
# Worker provides persistent quotas, request cache and video ingestion.
# Production requires HTTPS; a base path such as /forme-worker/ is supported.
FORME_WORKER_URL=
FORME_WORKER_TOKEN=
YT_DLP_BIN=yt-dlp
SOCAI_BIN=socai
WHISPER_PYTHON=python3
FFMPEG_BIN=ffmpeg
WORKER_PORT=8790
WHISPER_MODEL=small
# Optional desktop web search. Set both fields and use a separate eligible key.
# MCP URL: https://open.bigmodel.cn/api/mcp/web_search_prime/mcp or https://api.z.ai/api/mcp/web_search_prime/mcp
ZHIPU_WEB_SEARCH_MCP_URL=
ZHIPU_WEB_SEARCH_API_KEY=
# Desktop knowledge search defaults to local multilingual embedding + reranking.
# Public model files download once; saved text is processed on this computer.
# Use disabled for full-text only, or remote with a separate embeddings API key.
KNOWLEDGE_EMBEDDING_BACKEND=local
KNOWLEDGE_LOCAL_CACHE_DIR=.data/knowledge-models
# Choose KNOWLEDGE_EMBEDDING_BACKEND=remote to use the separately configured API.
ZHIPU_EMBEDDING_API_KEY=
ZHIPU_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_EMBEDDING_TIMEOUT_MS=15000
