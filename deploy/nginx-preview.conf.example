# Include within Nginx's http context. Replace the example domain and paths.
limit_req_zone $binary_remote_addr zone=folio_demo_preview:1m rate=6r/m;

server {
    listen 443 ssl;
    server_name demo.example.invalid;
    ssl_certificate /etc/letsencrypt/live/demo.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.invalid/privkey.pem;

    auth_basic "Folio Demo Preview";
    auth_basic_user_file /etc/nginx/folio-demo-preview.htpasswd;

    location = /api/forme {
        limit_req zone=folio_demo_preview burst=3 nodelay;
        limit_req_status 429;
        client_max_body_size 128k;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_read_timeout 125s;
        proxy_pass http://127.0.0.1:4186;
    }

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_pass http://127.0.0.1:4186;
    }
}
